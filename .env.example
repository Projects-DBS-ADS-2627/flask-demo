# Copy this file to .env (in this same folder) and fill in your group's details from Ufora.
# .env is in .gitignore: it stays on your laptop. Everyone in the group makes their own.
# No quotes around the values, no spaces around the =.

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Any long random string. Flask needs it for flash() messages.
SECRET_KEY=change-me

# Set to 1 to see every SQL query in your terminal while you build.
SQLALCHEMY_ECHO=0
